# Required. Generate with: openssl rand -base64 32
DASHBOARD_TOKEN=

# Origin the browser loads the UI from. Only needed if you bypass the nginx proxy.
DASHBOARD_CORS_ORIGINS=http://localhost:3000

# Path to a file holding the Ansible Vault password. Playbooks in this repository
# assert on vault-backed secrets, so without it those runs stop at the assert.
ANSIBLE_VAULT_PASSWORD_FILE=

# Force every run to --check. Useful for a shared or demo instance.
DASHBOARD_CHECK_MODE_ONLY=false

# SSH keys mounted into the backend for reaching managed hosts.
SSH_KEY_PATH=~/.ssh
