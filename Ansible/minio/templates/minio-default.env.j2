{{ ansible_managed | comment }}
# Bootstrap variables only. Read directly by systemd (EnvironmentFile=) and required
# to be non-empty (the unit's AssertFileNotEmpty check). Root credentials live in
# {{ minio_config_env_path }} instead, never here.
MINIO_VOLUMES="{{ minio_directory }}"
MINIO_OPTS="--address {{ minio_api_address }} --console-address {{ minio_console_address }}"
MINIO_CONFIG_ENV_FILE={{ minio_config_env_path }}
