apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ kubesphere_ingress_name }}
  namespace: {{ kubesphere_namespace }}
  annotations:
    cert-manager.io/cluster-issuer: {{ kubesphere_cluster_issuer_name }}
    nginx.ingress.kubernetes.io/ssl-redirect: "true"
spec:
  ingressClassName: {{ kubesphere_ingress_class }}
  rules:
    - host: {{ kubesphere_ingress_host }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{ kubesphere_service_name }}
                port:
                  number: {{ kubesphere_service_port }}
  tls:
    - hosts:
        - {{ kubesphere_ingress_host }}
      secretName: {{ kubesphere_ingress_tls_secret_name }}
