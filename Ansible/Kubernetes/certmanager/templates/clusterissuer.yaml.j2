apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: {{ certmanager_cluster_issuer_name }}
spec:
  acme:
    server: {{ certmanager_acme_server }}
    email: {{ certmanager_acme_email }}
    privateKeySecretRef:
      name: {{ certmanager_cluster_issuer_name }}
    solvers:
      - http01:
          ingress:
            ingressClassName: {{ certmanager_ingress_class }}
