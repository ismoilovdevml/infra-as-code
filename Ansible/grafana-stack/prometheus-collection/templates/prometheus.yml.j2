#
# Reference sample only - NOT deployed by any playbook in this repo.
#
# The live /etc/prometheus/prometheus.yml is generated by the prometheus.prometheus.prometheus
# role from the prometheus_scrape_configs variable, which install_prometheus.yml builds
# dynamically at runtime from `exporters` / `exporter_ports` (vars.yml) and the target_servers
# inventory group. This file shows the shape of the resulting configuration for a fleet with
# every exporter enabled, using inventory.ini's placeholder hosts.
#
# http://prometheus.io/docs/operating/configuration/

global:
  scrape_interval: 15s
  scrape_timeout: 10s
  evaluation_interval: 15s
  external_labels:
    environment: "{{ inventory_hostname }}"

rule_files:
  - /etc/prometheus/rules/*.rules

scrape_configs:
  - job_name: prometheus
    metrics_path: /metrics
    static_configs:
      - targets:
          - "localhost:{{ prometheus_http_port }}"

  - job_name: node_exporter
    static_configs:
      - targets:
          - "10.0.0.11:9100"
          - "10.0.0.12:9100"
          - "10.0.0.13:9100"

  - job_name: alertmanager
    static_configs:
      - targets:
          - "10.0.0.11:9093"
          - "10.0.0.12:9093"
          - "10.0.0.13:9093"

  # ... one job per exporter enabled in vars.yml `exporters`, same pattern, port from
  # `exporter_ports`. See install_prometheus.yml for the generator.
