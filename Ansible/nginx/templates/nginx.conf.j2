{{ ansible_managed | comment }}
user {{ nginx_user }};
worker_processes {{ nginx_worker_processes }};

error_log /var/log/nginx/error.log notice;
pid /var/run/nginx.pid;

events {
    worker_connections {{ nginx_worker_connections }};
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                     '$status $body_bytes_sent "$http_referer" '
                     '"$http_user_agent" "$http_x_forwarded_for"';

    access_log /var/log/nginx/access.log main;

    sendfile        on;
    keepalive_timeout {{ nginx_keepalive_timeout }};

    # Packaged fragment directory (nginx.org default). Kept for compatibility with anything
    # dropped here outside of this module.
    include /etc/nginx/conf.d/*.conf;

    # sites-available/sites-enabled is a Debian packaging convention that the nginx.org
    # package does not ship (confirmed upstream: docs.nginx.com only documents conf.d). This
    # module owns nginx.conf, so the include is added here directly instead of patching the
    # packaged file with a regex.
    include /etc/nginx/sites-enabled/*;
}
