# ======================== Elasticsearch Configuration =========================
#
# NOTE: Elasticsearch comes with reasonable defaults for most settings.
#       Before you set out to tweak and tune the configuration, make sure you
#       understand what are you trying to accomplish and the consequences.
#
# This file is managed by Ansible (elasticsearch/templates/elasticsearch.yml.j2).
# Manual edits will be overwritten on the next configure.yml run.
#
# Reference: https://www.elastic.co/docs/reference/elasticsearch/configuration-reference
#
# ---------------------------------- Cluster -----------------------------------
#
cluster.name: {{ cluster_name }}
#
# ------------------------------------ Node ------------------------------------
#
node.name: {{ node_name }}
#
node.attr.rack: {{ node_attr_rack }}
#
# ----------------------------------- Paths ------------------------------------
#
path.data: {{ path_data }}
#
path.logs: {{ path_logs }}
#
# ----------------------------------- Memory -----------------------------------
#
# Lock the memory on startup:
#
#bootstrap.memory_lock: true
#
# Set -Xms/-Xmx to no more than 50% of available memory via
# /etc/elasticsearch/jvm.options.d/ - do not edit the packaged jvm.options file.
#
# ---------------------------------- Network -----------------------------------
#
# WARNING: any address other than a loopback address here switches this node
# into production mode and enables bootstrap checks (vm.max_map_count, file
# descriptor limits, discovery settings). See vars.yml: network_host.
#
network.host: {{ network_host }}
#
http.port: {{ http_port }}
#
# --------------------------------- Discovery ----------------------------------
#
{% if discovery_seed_hosts | length > 0 %}
discovery.seed_hosts: {{ discovery_seed_hosts | to_json }}
{% else %}
#discovery.seed_hosts: ["host1", "host2"]
{% endif %}
#
# ---------------------------------- Various -----------------------------------
#
#action.destructive_requires_name: false

#----------------------- BEGIN SECURITY AUTO CONFIGURATION -----------------------
#
# The following settings, TLS certificates, and keys are generated by
# Elasticsearch itself on first startup of a node that is not yet part of a
# cluster. They are reproduced here so that re-templating this file does not
# remove them - see README.md Notes for the required install.yml -> first
# start -> configure.yml ordering.
#
# --------------------------------------------------------------------------------

xpack.security.enabled: {{ xpack_security_enabled | lower }}

xpack.security.enrollment.enabled: {{ xpack_security_enrollment_enabled | lower }}

# Enable encryption for HTTP API client connections, such as Kibana, Logstash, and Agents
xpack.security.http.ssl:
  enabled: {{ xpack_security_http_ssl_enabled | lower }}
  keystore.path: {{ xpack_security_http_ssl_keystore_path }}

# Enable encryption and mutual authentication between cluster nodes
xpack.security.transport.ssl:
  enabled: {{ xpack_security_transport_ssl_enabled | lower }}
  verification_mode: {{ xpack_security_transport_ssl_verification_mode }}
  keystore.path: {{ xpack_security_transport_ssl_keystore_path }}
  truststore.path: {{ xpack_security_transport_ssl_truststore_path }}

{% if cluster_bootstrap %}
# Only for the very first bootstrap of a brand-new cluster. Set
# cluster_bootstrap: false in vars.yml once the cluster has formed.
cluster.initial_master_nodes: {{ cluster_initial_master_nodes | to_json }}
{% endif %}

# Allow HTTP API connections from anywhere. Connections are encrypted and
# require user authentication.
http.host: {{ http_host }}

#----------------------- END SECURITY AUTO CONFIGURATION -------------------------
